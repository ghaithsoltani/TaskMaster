# ============================================
# JAVA / MAVEN
# ============================================
# Compiled Java classes - auto-generated by the compiler, not source code
target/
# Maven wrapper directory - can be regenerated with `mvn wrapper:wrapper`
#.mvn/
# Maven wrapper scripts for Unix/Linux - can be regenerated
#mvnw
# Maven wrapper scripts for Windows - can be regenerated
#mvnw.cmd
# Log files generated during builds or runtime
*.log
# Compiled Java bytecode files
*.class
# Eclipse IDE classpath file - auto-generated
.classpath
# Eclipse IDE project file - auto-generated
.project
# Eclipse IDE settings directory - auto-generated
.settings/
# VS Code Java extension classpath file
.factorypath

# ============================================
# ANGULAR / NODE
# ============================================
# All npm packages installed locally - huge directory, use package.json to recreate
frontend/node_modules/
# Compiled/bundled Angular production build output
frontend/dist/
# Angular CLI cache directory for faster rebuilds
frontend/.angular/
# Test coverage reports generated by tools like Karma/Jest
frontend/coverage/
# Log files specific to the frontend directory
frontend/*.log
# Generic cache directory for frontend build tools
frontend/.cache/

# ============================================
# IDE
# ============================================
# JetBrains IntelliJ IDEA / WebStorm / PhpStorm project settings directory
.idea/
# IntelliJ IDEA module files - one per module in multi-module projects
*.iml
# IntelliJ IDEA project resource files (replaced by .idea directory in newer versions)
*.ipr
# IntelliJ IDEA workspace settings (window positions, run configurations, etc.)
*.iws
# Visual Studio Code workspace settings directory
.vscode/
# Vim swap file (when file is open in Vim)
*.swp
# Vim swap file (when file is open in another Vim instance)
*.swo
# Backup files created by some text editors (e.g., Emacs, nano)
*~

# ============================================
# OS
# ============================================
# macOS system file storing folder metadata (icons, window positions)
.DS_Store
# Windows thumbnail cache database
Thumbs.db

# ============================================
# ENVIRONMENT / SECRETS
# ============================================
# Environment variables file (API keys, passwords, URLs) - NEVER commit secrets!
.env
# Local environment overrides (developer-specific settings)
.env.local
# Pattern for any local environment files (e.g., .env.development.local)
.env.*.local
# SSL/TLS certificate files (private keys, certificates)
*.pem
# Private key files (SSH, SSL, API signing keys) - SECURITY RISK if committed!
*.key

# ============================================
# DATABASE
# ============================================
# Generic database files
*.db
# SQLite database files
*.sqlite
# SQLite3 database files (newer version)
*.sqlite3

# ============================================
# DOCKER
# ============================================
# Docker-specific environment files (may contain container secrets)
*.env.docker

# ============================================
# LOGS
# ============================================
# Directory containing application log files
logs/
# All log files (duplicate of earlier *.log but ensures coverage)
*.log
# npm debug log files (created when npm commands fail)
npm-debug.log*
# Yarn debug log files (created when Yarn commands fail)
yarn-debug.log*
# Yarn error log files (created when Yarn commands fail)
yarn-error.log*

# ============================================
# TESTING
# ============================================
# Code coverage report files (generated by Istanbul/nyc)
*.lcov
# NYC (Istanbul command line) coverage output directory
.nyc_output/

# ============================================
# BUILD ARTIFACTS
# ============================================
# Generic build output directory
build/
# Java output directory (alternative to target/)
out/
# Distribution/build output directory
dist/
# Compiled Java archive (JAR) files - build from source instead
*.jar
# Compiled Java web application archive (WAR) files - build from source instead
*.war